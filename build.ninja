rule as
  command = cpp -I include $in | mips-linux-gnu-as -EB -march=vr4300 -mtune=vr4300 -G 0 -I include -o $out
  description = as $in
rule bin
  command = mips-linux-gnu-ld -r -b binary $in -o $out
  description = bin $in
rule ld
  command = mips-linux-gnu-ld -T ver/jp/undefined_syms.txt -T undefined_syms_auto.txt -Map $mapfile -T $in -o $out
  description = link $out
rule z64
  command = mips-linux-gnu-objcopy $in $out -O binary
  description = rom $out
rule sha1sum
  command = sha1sum -c $in && touch $out
  description = sha1sum $in
